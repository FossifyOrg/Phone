<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/permission_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/normal_margin"
    android:paddingVertical="@dimen/normal_margin">

    <ImageView
        android:id="@+id/permission_icon"
        android:layout_width="@dimen/normal_icon_size"
        android:layout_height="@dimen/normal_icon_size"
        android:layout_marginEnd="@dimen/normal_margin"
        android:importantForAccessibility="no"
        tools:src="@drawable/ic_phone_vector" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/permission_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            tools:text="Default phone app" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/permission_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tiny_margin"
            android:alpha="0.8"
            android:textSize="@dimen/smaller_text_size"
            tools:text="Lets this app handle incoming and outgoing calls." />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/small_margin"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/permission_status_icon"
                android:layout_width="@dimen/medium_icon_size"
                android:layout_height="@dimen/medium_icon_size"
                android:layout_marginEnd="@dimen/tiny_margin"
                android:importantForAccessibility="no"
                tools:src="@drawable/ic_check_circle_vector" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/permission_status_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/smaller_text_size"
                android:textStyle="bold"
                tools:text="Granted" />

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/permission_action"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/small_margin"
        android:minWidth="0dp"
        tools:text="@string/grant_permission" />

</LinearLayout>
