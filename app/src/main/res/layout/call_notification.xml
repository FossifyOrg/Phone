<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/notification_holder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="#fff">

    <TextView
        android:id="@+id/notification_caller_name"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/bigger_text_size"
        android:textStyle="bold"
        android:textDirection="firstStrongLtr"
        tools:text="Caller name" />

    <TextView
        android:id="@+id/notification_call_status"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/notification_caller_name"
        android:alpha="0.8"
        tools:text="123 456 789" />

    <ImageView
        android:id="@+id/notification_thumbnail"
        android:layout_width="@dimen/list_avatar_size"
        android:layout_height="@dimen/list_avatar_size"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true" />

    <LinearLayout
        android:id="@+id/notification_actions_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/notification_call_status"
        android:layout_marginTop="@dimen/activity_margin"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- The weighted holders only share the row; the clickable buttons keep a fixed size, so a
             tap next to "decline" (e.g. to open the call screen) can't end the call by accident. -->
        <FrameLayout
            android:id="@+id/notification_decline_call_holder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/notification_decline_call"
                android:layout_width="@dimen/call_notification_button_size"
                android:layout_height="@dimen/call_notification_button_size"
                android:layout_gravity="center"
                android:background="@drawable/ripple_background"
                android:contentDescription="@string/decline_call"
                android:padding="@dimen/small_margin"
                android:src="@drawable/ic_phone_down_red_vector" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/notification_accept_call_holder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/notification_accept_call"
                android:layout_width="@dimen/call_notification_button_size"
                android:layout_height="@dimen/call_notification_button_size"
                android:layout_gravity="center"
                android:background="@drawable/ripple_background"
                android:contentDescription="@string/accept_call"
                android:padding="@dimen/small_margin"
                android:src="@drawable/ic_phone_green_vector" />

        </FrameLayout>

    </LinearLayout>
</RelativeLayout>
